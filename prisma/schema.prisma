// ============================================================
// LUNA CRM — Schema Multi-Tenant Completo
// Nicho: Clínicas de Estética Corporal e Harmonização Facial
// Versão: 1.0 — Março 2026
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ============================================================
// AUTENTICAÇÃO E USUÁRIOS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PATIENT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(ADMIN)
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamMemberships CrmTeamMember[]

  @@index([email])
  @@index([role])
}

// ============================================================
// MULTI-TENANCY
// ============================================================

model CrmTenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // White-label (Enterprise)
  customLogo   String?
  customColors Json?
  customDomain String?   @unique
  whiteLabel   Boolean   @default(false)

  // Status
  isActive     Boolean   @default(true)
  suspendedAt  DateTime?

  // Relations
  subscription         Subscription?
  pipelines            Pipeline[]
  leads                Lead[]
  channels             CrmChannel[]
  conversations        Conversation[]
  automations          CrmAutomation[]
  automationLogs       CrmAutomationLog[]
  integrations         CrmIntegration[]
  auditLogs            CrmAuditLog[]
  knowledgeBase        CrmKnowledgeBase[]
  notifications        CrmNotification[]
  notificationSettings CrmNotificationSetting[]
  aiConfig             CrmAiConfig?
  tasks                CrmTask[]
  templates            CrmTemplate[]
  broadcasts           CrmBroadcast[]
  npsConfig            CrmNpsConfig?
  npsResponses         CrmNpsResponse[]
  proposals            CrmProposal[]
  teamMembers          CrmTeamMember[]
  marketingSpend       CrmMarketingSpend[]
  activityLogs         CrmActivityLog[]
  goals                CrmGoal[]
  botFlows             CrmBotFlow[]
  botSessions          CrmBotSession[]
  retentionCycles      RetentionCycle[]
  retentionAlerts      RetentionAlert[]

  @@index([slug])
  @@index([customDomain])
  @@index([isActive])
}

// ============================================================
// EQUIPE — Vínculo User <> Tenant
// ============================================================

enum TeamRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
}

model CrmTeamMember {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String
  role           TeamRole @default(AGENT)
  isActive       Boolean  @default(true)
  commissionRate Float?
  inviteToken    String?  @unique
  inviteEmail    String?
  invitedAt      DateTime?
  joinedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, isActive])
  @@index([inviteToken])
}

// ============================================================
// BILLING / PLANOS
// ============================================================

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model SubscriptionPlan {
  id          String @id @default(cuid())
  name        String @unique
  displayName String
  priceMonthly Float
  priceYearly  Float?

  // Limites
  maxPipelines     Int @default(1)
  maxLeads         Int @default(500)
  maxChannels      Int @default(1)
  maxTeamMembers   Int @default(2)
  maxAutomations   Int @default(5)
  maxKnowledgeDocs Int @default(3)
  maxBotFlows      Int @default(1)

  // Features Site
  hasSite             Boolean @default(true)
  siteTemplateOptions Int     @default(1)
  hasCustomDomain     Boolean @default(false)
  hasPatientPortal    Boolean @default(false)
  maxGalleryPhotos    Int     @default(20)

  // Features CRM
  hasAiScore         Boolean @default(false)
  hasGoldenWindow    Boolean @default(false)
  hasRetentionRadar  Boolean @default(true)
  retentionMaxProcs  Int     @default(3)
  hasConcierge       Boolean @default(false)
  hasBotBuilder      Boolean @default(false)
  hasAdvancedReports Boolean @default(false)
  hasWhiteLabel      Boolean @default(false)
  hasApiAccess       Boolean @default(false)
  hasBroadcast       Boolean @default(false)
  hasNps             Boolean @default(false)
  hasProposals       Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id       String             @id @default(cuid())
  tenantId String             @unique
  planId   String
  status   SubscriptionStatus @default(TRIAL)

  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  suspendedAt        DateTime?

  billingProvider    String?
  externalId         String?
  externalCustomerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant CrmTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([planId])
}

model UsageMetric {
  id       String @id @default(cuid())
  tenantId String
  metric   String
  value    Float
  period   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, metric, period])
  @@index([tenantId, period])
}

model BillingEvent {
  id         String   @id @default(cuid())
  tenantId   String
  type       String
  amount     Float?
  currency   String   @default("BRL")
  externalId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
}

// ============================================================
// CRM CORE — Pipeline, Leads, Conversas
// ============================================================

enum LeadStatus {
  COLD
  WARM
  HOT
  WON
  LOST
}

enum StageType {
  OPEN
  WON
  LOST
}

enum CrmMessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
  SYSTEM_LOG
}

model Pipeline {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages Stage[]
  leads  Lead[]

  @@index([tenantId])
}

model Stage {
  id             String    @id @default(cuid())
  pipelineId     String
  tenantId       String
  name           String
  type           StageType @default(OPEN)
  order          Int
  cachedLeadCount  Int     @default(0)
  cachedTotalValue Float   @default(0)
  cacheUpdatedAt   DateTime?
  color          String?
  createdAt      DateTime  @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@index([pipelineId])
  @@index([tenantId])
}

model Lead {
  id         String     @id @default(cuid())
  tenantId   String
  pipelineId String
  stageId    String
  status     LeadStatus @default(WARM)

  name   String
  phone  String
  email  String?
  source String?
  tags   String[]

  position      Float  @default(0)
  expectedValue Float?

  aiScore      Float?
  aiScoreLabel String?
  churnRisk    Float?

  bestContactDays  String?
  bestContactHours String?
  bestContactBasis Int?

  lastInteractionAt DateTime?
  lostReason        String?
  deletedAt         DateTime?

  patientId           String?
  linkedAppointmentId String?
  assignedToUserId    String?

  pipeline      Pipeline       @relation(fields: [pipelineId], references: [id])
  stage         Stage          @relation(fields: [stageId], references: [id])
  tenant        CrmTenant      @relation(fields: [tenantId], references: [id])
  conversations Conversation[]
  activities    LeadActivity[]
  retentionAlerts RetentionAlert[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@index([tenantId, stageId, position])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([tenantId, lastInteractionAt])
  @@index([tenantId, phone])
  @@index([tenantId, assignedToUserId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  payload   Json
  createdBy String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model CrmChannel {
  id          String   @id @default(cuid())
  tenantId    String
  type        String
  name        String
  instanceId  String?
  credentials Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant        CrmTenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId])
  @@index([tenantId, type])
}

model Conversation {
  id               String   @id @default(cuid())
  tenantId         String
  leadId           String
  channelId        String
  remoteJid        String
  unreadCount      Int      @default(0)
  isClosed         Boolean  @default(false)
  lastMessageAt    DateTime @default(now())
  assignedToUserId String?

  tenant   CrmTenant  @relation(fields: [tenantId], references: [id])
  lead     Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel  CrmChannel @relation(fields: [channelId], references: [id])
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, remoteJid])
  @@index([tenantId, isClosed, lastMessageAt(sort: Desc)])
  @@index([leadId])
}

model Message {
  id             String         @id @default(cuid())
  conversationId String
  tenantId       String
  waMessageId    String         @unique

  fromMe        Boolean
  type          CrmMessageType @default(TEXT)
  content       String         @db.Text
  mediaMimeType String?
  mediaUrl      String?

  isClinicalMedia Boolean @default(false)

  status String    @default("SENT")
  readAt DateTime?

  sentByUserId String?
  sentiment    String?
  aiSummary    String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([tenantId, isClinicalMedia])
  @@index([tenantId])
}

// ============================================================
// RADAR DE RETENÇÃO BIOLÓGICO — KILLER FEATURE
// ============================================================

model RetentionCycle {
  id       String @id @default(cuid())
  tenantId String

  procedureName    String
  followUpDays     Int
  returnDays       Int
  reactivationStart Int
  reactivationEnd   Int

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, procedureName])
  @@index([tenantId, isActive])
}

model RetentionAlert {
  id       String @id @default(cuid())
  tenantId String
  leadId   String

  procedureName String
  procedureDate DateTime
  returnDueDate DateTime
  riskLevel     String
  riskScore     Float

  followUpSentAt    DateTime?
  reactivationSentAt DateTime?
  resolvedAt        DateTime?
  resolvedReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, riskLevel])
  @@index([tenantId, returnDueDate])
  @@index([leadId])
}

// ============================================================
// IA, AUTOMAÇÃO, BOT
// ============================================================

enum AutomationTrigger {
  NEW_MESSAGE_RECEIVED
  LEAD_STAGE_CHANGED
  LEAD_CREATED
  CONTACT_IDLE
  APPOINTMENT_BOOKED
  APPOINTMENT_COMPLETED
  RETENTION_ALERT
}

model CrmAiConfig {
  id       String @id @default(cuid())
  tenantId String @unique

  geminiKey     String?
  groqKey       String?
  openrouterKey String?
  togetherKey   String?
  openaiKey     String?
  claudeKey     String?

  preferredProvider String?
  temperature       Float   @default(0.7)
  maxTokens         Int     @default(1024)

  autoReplyEnabled  Boolean @default(false)
  autoReplyDelay    Int     @default(3000)
  autoReplyTemplate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CrmKnowledgeBase {
  id         String   @id @default(cuid())
  tenantId   String
  title      String
  content    String   @db.Text
  embedding  Unsupported("vector(768)")?
  chunkIndex Int      @default(0)
  sourceFile String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, sourceFile])
}

model CrmAutomation {
  id       String            @id @default(cuid())
  tenantId String
  name     String
  trigger  AutomationTrigger
  flowJson Json
  isActive Boolean           @default(false)

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs      CrmAutomationLog[]

  @@index([tenantId, trigger, isActive])
}

model CrmAutomationLog {
  id           String   @id @default(cuid())
  tenantId     String
  automationId String
  leadId       String?
  status       String
  nodeId       String?
  error        String?
  executedAt   DateTime @default(now())

  tenant     CrmTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  automation CrmAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([tenantId, executedAt(sort: Desc)])
  @@index([automationId])
}

model CrmBotFlow {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  nodes    Json
  edges    Json
  isActive Boolean @default(false)

  tenant   CrmTenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions CrmBotSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, isActive])
}

model CrmBotSession {
  id        String   @id @default(cuid())
  tenantId  String
  botFlowId String
  leadId    String
  currentNodeId String?
  state     Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  CrmTenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  botFlow CrmBotFlow @relation(fields: [botFlowId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, isActive])
}

// ============================================================
// INTEGRAÇÃO, AUDITORIA, LGPD
// ============================================================

model CrmIntegration {
  id          String   @id @default(cuid())
  tenantId    String
  provider    String
  credentials Json
  isActive    Boolean  @default(true)
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId, isActive])
}

model CrmAuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, userId])
  @@index([tenantId, action])
}

// ============================================================
// OPERACIONAL — Notificações, Tasks, Templates, Broadcast
// ============================================================

model CrmNotification {
  id       String   @id @default(cuid())
  tenantId String
  userId   String
  type     String
  title    String
  body     String?
  link     String?
  isRead   Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@index([tenantId, createdAt(sort: Desc)])
}

model CrmNotificationSetting {
  id       String  @id @default(cuid())
  tenantId String
  userId   String
  type     String
  enabled  Boolean @default(true)

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, type])
}

model CrmTask {
  id          String    @id @default(cuid())
  tenantId    String
  leadId      String?
  title       String
  description String?
  dueDate     DateTime?
  assignedTo  String?
  status      String    @default("pending")
  priority    String    @default("normal")
  completedAt DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@index([tenantId, dueDate])
}

model CrmTemplate {
  id       String @id @default(cuid())
  tenantId String
  name     String
  category String @default("general")
  type     String @default("whatsapp")
  content  String @db.Text
  variables String[]
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@index([tenantId, type])
}

model CrmBroadcast {
  id       String @id @default(cuid())
  tenantId String
  name     String
  templateId String?
  filters  Json?
  status   String @default("draft")
  scheduledAt DateTime?
  sentAt     DateTime?
  totalSent  Int @default(0)
  totalFailed Int @default(0)
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients CrmBroadcastRecipient[]

  @@index([tenantId, status])
}

model CrmBroadcastRecipient {
  id          String   @id @default(cuid())
  broadcastId String
  leadId      String
  status      String   @default("pending")
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  error       String?

  broadcast CrmBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId, status])
}

// ============================================================
// NPS, PROPOSTAS, MARKETING, METAS
// ============================================================

model CrmNpsConfig {
  id       String  @id @default(cuid())
  tenantId String  @unique
  isActive Boolean @default(false)
  delayHours Int   @default(24)
  message  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CrmNpsResponse {
  id       String @id @default(cuid())
  tenantId String
  leadId   String?
  score    Int
  comment  String?
  procedureType String?
  createdAt DateTime @default(now())

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
}

model CrmProposal {
  id       String @id @default(cuid())
  tenantId String
  leadId   String?
  token    String @unique @default(cuid())
  title    String
  status   String @default("DRAFT")

  subtotal  Float
  discount  Float  @default(0)
  total     Float

  validUntil DateTime?
  viewedAt   DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?

  notes     String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant CrmTenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  CrmProposalItem[]

  @@index([tenantId, status])
  @@index([token])
}

model CrmProposalItem {
  id         String @id @default(cuid())
  proposalId String
  name       String
  quantity   Int    @default(1)
  unitPrice  Float
  discount   Float  @default(0)

  proposal CrmProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model CrmMarketingSpend {
  id       String @id @default(cuid())
  tenantId String
  source   String
  amount   Float
  period   String
  leadsGenerated Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, period])
  @@index([tenantId, period])
}

model CrmActivityLog {
  id       String @id @default(cuid())
  tenantId String
  userId   String?
  type     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, type])
}

model CrmGoal {
  id       String @id @default(cuid())
  tenantId String
  type     String @default("revenue")
  target   Float
  current  Float  @default(0)
  period   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant CrmTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, period])
  @@index([tenantId, period])
}

// ============================================================
// DEMO & SUPORTE
// ============================================================

model DemoSession {
  id            String   @id @default(cuid())
  visitorEmail  String?
  visitorName   String?
  visitorClinic String?
  startedAt     DateTime @default(now())
  tourStep      Int      @default(0)
  convertedToTrial Boolean @default(false)
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?

  @@index([convertedToTrial])
  @@index([startedAt])
}

model SupportTicket {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  subject   String
  body      String    @db.Text
  status    String    @default("open")
  priority  String    @default("normal")
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, status])
  @@index([status, priority])
}
